# Copie para .env.local (local) e cadastre as mesmas variáveis na Vercel.

# --- Supabase (Project Settings → API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública ("publishable", sb_publishable_...). Projetos antigos: use a "anon".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (service role). SÓ NO SERVIDOR. Usada apenas para enviar convites
# a quem ainda não tem conta e no script de seed. Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app (links dos e-mails). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Seed dos usuários demo (scripts/seed-usuarios.mjs) ----------------------
SEED_CONSULTOR_EMAIL=
SEED_CONSULTOR_NOME=João Pedro
SEED_SENHA_DEMO=

# --- Anthropic (a partir da Etapa 4) -----------------------------------------
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_EXTRACAO=
# ANTHROPIC_MODEL_INSIGHTS=

# --- Testes de RLS (opcional) ------------------------------------------------
# Postgres local onde os testes criam o banco descartável "resolutto_family_test".
# TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
